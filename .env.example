# Copy to `.env` and fill in. `.env` and `.env.local` are gitignored.
#
# Most knobs are optional and only consumed by specific extras
# (CLI vs SRE agent). Sections are labeled below.

# ---------------------------------------------------------------------------
# CLI (`yertle …`) — yertle[cli]
# ---------------------------------------------------------------------------
# Either of these can also be persisted to ~/.yertle/config.json via
# `yertle login`. Env vars take precedence per-key.

# YERTLE_TOKEN=yrt_...
# YERTLE_API_URL=https://api.yertle.com

# ---------------------------------------------------------------------------
# SRE agent (`yertle-sre …`) — yertle[sre]
# ---------------------------------------------------------------------------
# Only ANTHROPIC_API_KEY is required to run the agent. Everything else has
# sensible defaults. The yertle / aws / gh CLIs the agent shells out to use
# their own auth (yertle login / aws configure / gh auth login).

# ANTHROPIC_API_KEY=

# Defaults shown; uncomment to override.
# YERTLE_SRE_MODEL=claude-sonnet-4-6
# YERTLE_SRE_TOOL_TIMEOUT=30
# YERTLE_SRE_MAX_TOOL_OUTPUT=10000
# YERTLE_SRE_MAX_ITERATIONS=25
# YERTLE_SRE_ALLOW_WRITES=false

# ---------------------------------------------------------------------------
# Optional — LangSmith tracing (off by default; SRE agent only)
# ---------------------------------------------------------------------------
# When LANGCHAIN_TRACING_V2 is set to "true", every LLM call, tool call, and
# graph step from this agent is sent to LangSmith — a third-party hosted
# service from LangChain — for inspection in their UI. Highly recommended
# during development; catches looping agents, wrong tool choices, and prompt
# regressions.
#
# PRIVACY: traces include the full message history — system prompt, tool
# results, AWS resource IDs, GitHub data, anything the agent reads. Fine for
# personal dev use. Do NOT enable in shared/CI/production contexts without
# understanding what gets sent.
#
# Sign up for a free dev account (5k traces/month) at https://smith.langchain.com.

# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=yertle-sre
